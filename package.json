{
  "name": "gobook-now",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --parallel --stream --filter backend --filter frontend run dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend start:dev",
    "test:e2e:prepare": "pnpm --filter backend test:browser:prepare",
    "test:e2e": "pnpm --filter backend test:browser",
    "test:e2e:smoke": "pnpm --filter frontend exec playwright test --config playwright.smoke.config.ts"
  },
  "devDependencies": {
    "turbo": "^2.10.13"
  }
}
