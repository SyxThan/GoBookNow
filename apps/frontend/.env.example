NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_PORTAL_KIND=customer
# Public project DSN is optional; never put an auth token in NEXT_PUBLIC_*.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Server runtime monitoring (optional).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Build-only secrets; set through CI secret storage, never in browser variables.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3000
NEXT_PUBLIC_VENDOR_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
