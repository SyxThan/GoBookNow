PORT=3001
# Use IPv4 explicitly: localhost can resolve to an unresponsive ::1 Docker port on Windows.
DATABASE_URL="postgresql://gobook:gobook_dev@127.0.0.1:5432/gobook?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=7
BOOKING_HOLD_TTL_MINUTES=10
# Explicit platform fee on net Booking amount; 1000 BPS = 10%.
PLATFORM_COMMISSION_BPS=1000
BOOKING_EXPIRATION_INTERVAL_SECONDS=60
BOOKING_EXPIRATION_BATCH_SIZE=100
AUTH_REFRESH_COOKIE_NAME="gobook_refresh_token"
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE="lax"
FRONTEND_ORIGIN="http://localhost:3000"
VENDOR_ORIGIN="http://localhost:3002"
ADMIN_ORIGIN="http://localhost:3003"
SWAGGER_ENABLED=true
FILE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gobook/services
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET=
# Browser return URLs. Blank values fall back to FRONTEND_ORIGIN/payment/result.
SEPAY_SUCCESS_URL=http://localhost:3000/payment/result
SEPAY_ERROR_URL=http://localhost:3000/payment/result
SEPAY_CANCEL_URL=http://localhost:3000/payment/result
# In SePay sandbox merchant settings, configure IPN separately:
# https://YOUR_PUBLIC_BACKEND/api/v1/webhooks/sepay/ipn (SECRET_KEY authentication).
# SePay servers cannot call localhost; use a public HTTPS endpoint for local tests.
TICKET_TOKEN_SECRET=

# Exact comma-separated origins; production requires explicit HTTPS origins.
CORS_ORIGINS=http://localhost:3000
# Empty disables proxy trust. Set only known ingress IP/CIDR ranges, never true/1.
TRUST_PROXY_CIDRS=
RATE_LIMIT_STORAGE=memory
# Production memory mode requires an explicit single-process guarantee.
RATE_LIMIT_SINGLE_INSTANCE=false
# Dedicated deployment Redis; do not reuse test or local dev instances in production.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_IP=20
RATE_LIMIT_AUTH_ACCOUNT=10
RATE_LIMIT_AUTH_SUBJECT=10
RATE_LIMIT_REFRESH_IP=120
RATE_LIMIT_REFRESH_SUBJECT=120
RATE_LIMIT_READ_IP=1200
RATE_LIMIT_READ_SUBJECT=300
RATE_LIMIT_WRITE_IP=600
RATE_LIMIT_WRITE_SUBJECT=120
RATE_LIMIT_WEBHOOK_IP=120
# Valid authenticated SePay callbacks bypass generic limiting; see docs.

# Optional monitoring; keep DSN empty to disable. Never use real values in Git.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
