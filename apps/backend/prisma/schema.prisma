generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RefreshTokenRevokedReason {
  ROTATED
  LOGOUT
  ACCOUNT_DISABLED
}

enum VendorStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VendorType {
  INDIVIDUAL
  HOUSEHOLD_BUSINESS
  COMPANY
  ORGANIZATION
}

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorDocumentType {
  BUSINESS_REGISTRATION
  TAX_DOCUMENT
  REPRESENTATIVE_ID
  OTHER
}

enum CategoryScope {
  SERVICE
  EVENT
}

model Category {
  id String @id @default(uuid()) @db.Uuid

  code  String        @unique @db.VarChar(50)
  name  String        @db.VarChar(120)
  slug  String        @unique @db.VarChar(150)
  scope CategoryScope

  description String? @db.VarChar(500)
  icon        String? @db.VarChar(100)

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([scope])
  @@index([scope, isActive])
  @@index([sortOrder])
  @@map("categories")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email        String  @unique @db.VarChar(320)
  passwordHash String? @map("password_hash") @db.VarChar(255)

  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  profile       UserProfile?
  vendor        Vendor?
  userRoles     UserRole[]
  refreshTokens RefreshToken[]

  reviewedVendorApplications      VendorApplication[]        @relation("VendorApplicationReviewer")
  vendorApplicationHistoryEntries VendorApplicationHistory[] @relation("VendorApplicationHistoryActor")
  actorAuditLogs                  AuditLog[]                 @relation("AuditActor")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  tokenHash String @unique @map("token_hash") @db.Char(64)
  familyId  String @map("family_id") @db.Uuid

  expiresAt DateTime @map("expires_at")

  revokedAt     DateTime?                  @map("revoked_at")
  revokedReason RefreshTokenRevokedReason? @map("revoked_reason")

  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  lastUsedAt        DateTime? @map("last_used_at")

  userAgent String? @map("user_agent") @db.VarChar(500)
  ipAddress String? @map("ip_address") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model UserProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid

  fullName  String  @map("full_name") @db.VarChar(120)
  phone     String? @db.VarChar(20)
  avatarUrl String? @map("avatar_url") @db.VarChar(500)

  locale   String @default("vi-VN") @db.VarChar(16)
  timezone String @default("Asia/Ho_Chi_Minh") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)

  isSystem Boolean @default(true) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Vendor {
  id String @id @default(uuid()) @db.Uuid

  ownerUserId String @unique @map("owner_user_id") @db.Uuid

  displayName String  @map("display_name") @db.VarChar(150)
  slug        String  @unique @db.VarChar(180)
  description String? @db.VarChar(1000)
  logoUrl     String? @map("logo_url") @db.VarChar(500)

  legalName                  String?     @map("legal_name") @db.VarChar(200)
  vendorType                 VendorType? @map("vendor_type")
  taxCode                    String?     @unique @map("tax_code") @db.VarChar(50)
  businessRegistrationNumber String?     @unique @map("business_registration_number") @db.VarChar(100)
  legalRepresentativeName    String?     @map("legal_representative_name") @db.VarChar(150)

  contactEmail String? @map("contact_email") @db.VarChar(320)
  contactPhone String? @map("contact_phone") @db.VarChar(30)

  addressLine String? @map("address_line") @db.VarChar(255)
  ward        String? @db.VarChar(100)
  district    String? @db.VarChar(100)
  province    String? @db.VarChar(100)
  countryCode String  @default("VN") @map("country_code") @db.VarChar(2)

  status VendorStatus @default(DRAFT)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner        User                @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  applications VendorApplication[]

  @@index([status])
  @@index([displayName])
  @@map("vendors")
}

model VendorApplication {
  id String @id @default(uuid()) @db.Uuid

  vendorId String @map("vendor_id") @db.Uuid

  status VendorApplicationStatus @default(PENDING)

  submittedAt DateTime  @default(now()) @map("submitted_at")
  reviewedAt  DateTime? @map("reviewed_at")

  reviewedByUserId String? @map("reviewed_by_user_id") @db.Uuid
  reviewNote       String? @map("review_note") @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  reviewer User?  @relation("VendorApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  documents VendorApplicationDocument[]
  history   VendorApplicationHistory[]

  @@index([vendorId])
  @@index([status])
  @@index([submittedAt])
  @@map("vendor_applications")
}

model VendorApplicationDocument {
  id String @id @default(uuid()) @db.Uuid

  applicationId String @map("application_id") @db.Uuid

  documentType VendorDocumentType @map("document_type")
  originalName String             @map("original_name") @db.VarChar(255)
  storedName   String             @map("stored_name") @db.VarChar(255)
  fileUrl      String             @map("file_url") @db.VarChar(500)
  mimeType     String             @map("mime_type") @db.VarChar(100)
  fileSize     Int                @map("file_size")
  uploadedAt   DateTime           @default(now()) @map("uploaded_at")

  application VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("vendor_application_documents")
}

model VendorApplicationHistory {
  id String @id @default(uuid()) @db.Uuid

  applicationId String @map("application_id") @db.Uuid

  fromStatus VendorApplicationStatus? @map("from_status")
  toStatus   VendorApplicationStatus  @map("to_status")

  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  note            String?  @db.VarChar(1000)
  createdAt       DateTime @default(now()) @map("created_at")

  application VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User              @relation("VendorApplicationHistoryActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([changedByUserId])
  @@map("vendor_application_history")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorUserId String? @map("actor_user_id") @db.Uuid

  action     String @db.VarChar(100)
  entityType String @map("entity_type") @db.VarChar(100)
  entityId   String @map("entity_id") @db.VarChar(100)

  targetUserId String? @map("target_user_id") @db.Uuid
  metadata     Json?

  ipAddress String? @map("ip_address") @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
