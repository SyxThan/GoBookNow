generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RefreshTokenRevokedReason {
  ROTATED
  LOGOUT
  ACCOUNT_DISABLED
}

enum VendorStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VendorType {
  INDIVIDUAL
  HOUSEHOLD_BUSINESS
  COMPANY
  ORGANIZATION
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email        String  @unique @db.VarChar(320)
  passwordHash String? @map("password_hash") @db.VarChar(255)

  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  profile       UserProfile?
  vendor        Vendor?
  userRoles     UserRole[]
  refreshTokens RefreshToken[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  tokenHash String @unique @map("token_hash") @db.Char(64)
  familyId  String @map("family_id") @db.Uuid

  expiresAt DateTime @map("expires_at")

  revokedAt     DateTime?                  @map("revoked_at")
  revokedReason RefreshTokenRevokedReason? @map("revoked_reason")

  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  lastUsedAt        DateTime? @map("last_used_at")

  userAgent String? @map("user_agent") @db.VarChar(500)
  ipAddress String? @map("ip_address") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model UserProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid

  fullName  String  @map("full_name") @db.VarChar(120)
  phone     String? @db.VarChar(20)
  avatarUrl String? @map("avatar_url") @db.VarChar(500)

  locale   String @default("vi-VN") @db.VarChar(16)
  timezone String @default("Asia/Ho_Chi_Minh") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)

  isSystem Boolean @default(true) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Vendor {
  id String @id @default(uuid()) @db.Uuid

  ownerUserId String @unique @map("owner_user_id") @db.Uuid

  displayName String  @map("display_name") @db.VarChar(150)
  slug        String  @unique @db.VarChar(180)
  description String? @db.VarChar(1000)
  logoUrl     String? @map("logo_url") @db.VarChar(500)

  legalName                  String?     @map("legal_name") @db.VarChar(200)
  vendorType                 VendorType? @map("vendor_type")
  taxCode                    String?     @unique @map("tax_code") @db.VarChar(50)
  businessRegistrationNumber String?     @unique @map("business_registration_number") @db.VarChar(100)
  legalRepresentativeName    String?     @map("legal_representative_name") @db.VarChar(150)

  contactEmail String? @map("contact_email") @db.VarChar(320)
  contactPhone String? @map("contact_phone") @db.VarChar(30)

  addressLine String? @map("address_line") @db.VarChar(255)
  ward        String? @db.VarChar(100)
  district    String? @db.VarChar(100)
  province    String? @db.VarChar(100)
  countryCode String  @default("VN") @map("country_code") @db.VarChar(2)

  status VendorStatus @default(DRAFT)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([displayName])
  @@map("vendors")
}
