NODE_ENV=test
# Dedicated PostgreSQL service from docker-compose.integration.yml, never the dev DB.
DATABASE_URL=postgresql://test:test@127.0.0.1:5433/gobook_test?schema=public
INTEGRATION_TEST_ALLOW_CLEANUP=1
JWT_ACCESS_SECRET=integration-only-access-secret
JWT_ACCESS_EXPIRES_IN=15m
SEPAY_ENV=sandbox
SEPAY_IPN_SECRET=integration-only-ipn-secret
TICKET_TOKEN_SECRET=integration-only-ticket-secret
PLATFORM_COMMISSION_BPS=1000
BOOKING_HOLD_TTL_MINUTES=10
